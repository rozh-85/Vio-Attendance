# Which data backend to use: "supabase" (the live project) or "local"
# (browser localStorage, handy for a quick offline demo).
VITE_DATA_BACKEND=supabase

# Supabase connection (only needed when VITE_DATA_BACKEND=supabase).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Who may open the shared-phone report at /rozhadmin. Both are optional and
# override the defaults compiled into src/services/auth/ownerGate.ts.
# Setting VITE_OWNER_PASSWORD here keeps the password out of the repo — but note
# that VITE_ variables are inlined into the browser bundle either way, so this
# gate hides the page, it does not secure the data. That is Postgres's job.
VITE_OWNER_EMAIL=
VITE_OWNER_PASSWORD=
